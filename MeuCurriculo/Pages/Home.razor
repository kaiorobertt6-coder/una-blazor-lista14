        },
        new Experiencia {
            Empresa = "UNA-Barreiro",
            Cargo = "estudante-UC programação de Soluções computacionais",
            Inicio = "06/2025", Fim = "12/2025",
            Descricao = "Lógica de programação,Algoritimos, linguagens de programação."
        }
    };
}